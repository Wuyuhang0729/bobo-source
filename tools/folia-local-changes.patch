@@ -1007,6 +1007,139 @@ export interface FoliumProviderSong {
 /** Audio quality levels an Omni provider may be asked for. */
 export type FoliumAudioQuality = 'standard' | 'high' | 'lossless' | 'hires';
 
+/**
+ * EXPERIMENTAL (`omni.providers`): the signed-in account as Folium shows it.
+ * `id` is the provider's own user id; keep it stable across logins.
+ */
+export interface FoliumProviderUser {
+    id: string;
+    nickname: string;
+    avatarUrl?: string;
+    backgroundUrl?: string;
+    vipType?: number;
+}
+
+/** EXPERIMENTAL (`omni.providers`): what polling one QR session reports. */
+export type FoliumProviderQrState =
+    | { state: 'waiting' }
+    | { state: 'scanned' }
+    | { state: 'confirmed' }
+    | { state: 'expired' }
+    | { state: 'error'; message?: string };
+
+/**
+ * EXPERIMENTAL (`omni.providers`): account login for a mod provider.
+ *
+ * The host drives a provider-neutral QR flow: `getQrKey()` → `createQr(key)` → poll
+ * `checkQr(key)` until it leaves `waiting`. Return the QR however you like — an https URL
+ * (the host points an <img> at it) or a `data:` URL work equally well.
+ *
+ * Omit `getQrLoginMethods` for a single-step flow (one QR, no method picker), which is what
+ * a provider with a single scan target wants.
+ */
+export interface FoliumOmniProviderAuth {
+    getLoginStatus(): Promise<FoliumProviderUser | null>;
+    logout(): Promise<void>;
+    /** A new session key, opaque to the host. */
+    getQrKey?(): Promise<string>;
+    /** The QR image to show for that key. */
+    createQr?(key: string): Promise<string>;
+    checkQr?(key: string): Promise<FoliumProviderQrState>;
+    /** Must be idempotent: the host calls it fire-and-forget when the modal closes. */
+    cancelQr?(key: string): Promise<void>;
+    /** Declare it and the host times the QR itself; omit to only trust reported expiry. */
+    getQrTtlMs?(): number;
+}
+
+/**
+ * EXPERIMENTAL (`omni.providers`): one collection (playlist / album / radio) a provider exposes.
+ * `type` is free-form; the host routes unknown types to its playlist views.
+ */
+export interface FoliumProviderCollection {
+    /** Collection id within this provider. */
+    id: string;
+    /** Display name. */
+    name: string;
+    /** `playlist` | `album` | `radio` | … Defaults to `playlist`. */
+    type?: string;
+    /** Cover image URL. */
+    coverUrl?: string;
+    /** Shown under the name. */
+    description?: string;
+    /** Track count, when known. */
+    trackCount?: number;
+    /** Play count, when known. */
+    playCount?: number;
+    /** Created by the signed-in user (as opposed to merely collected). */
+    isOwned?: boolean;
+    /** Creator display name. */
+    creatorName?: string;
+    /**
+     * Opaque per-provider extras, forwarded to the host collection untouched.
+     *
+     * LOCAL CHANGE (bodian-source): the mod needs this to remember which upstream catalog an id
+     * came from — Bodian's playlists live behind `source` values that are not derivable from the
+     * id alone, so `getCollectionTracks` has to read it back when a collection is opened.
+     */
+    providerData?: Record<string, unknown>;
+}
+
+/**
+ * EXPERIMENTAL (`omni.providers`): the signed-in user's library.
+ *
+ * Declaring this is what lights up the host's 歌单/专辑 tabs for a mod provider. Without it
+ * `capabilities.userLibrary` stays false, those tabs render disabled — and since search follows
+ * the active tab, search would never route to this provider either. Pages are offset-based.
+ */
+export interface FoliumOmniProviderLibrary {
+    /** The user's collections (own + collected). */
+    getUserCollections(userId: string, page: { limit: number; offset: number }):
+        Promise<{ items: FoliumProviderCollection[]; hasMore: boolean; total?: number }>;
+    /**
+     * Tracks inside one collection; omit to make collections non-openable.
+     *
+     * LOCAL CHANGE (bodian-source): `providerData` hands back whatever the mod attached to the
+     * collection it listed (see FoliumProviderCollection.providerData), because some upstreams need
+     * more than the id to resolve a track page.
+     */
+    getCollectionTracks?(collectionId: string, page: { limit: number; offset: number }, providerData?: Record<string, unknown>):
+        Promise<{ items: FoliumProviderSong[]; hasMore: boolean; total?: number }>;
+    /**
+     * The user's collected albums. Declaring it sets `capabilities.userAlbums`, which is what the
+     * host's 专辑 tab checks (together with userLibrary). Omit and that tab stays disabled.
+     */
+    getUserAlbums?(userId: string, page: { limit: number; offset: number }):
+        Promise<{ items: FoliumProviderCollection[]; hasMore: boolean; total?: number }>;
+    /**
+     * Tracks of one album from `getUserAlbums`.
+     *
+     * LOCAL CHANGE (bodian-source): upstream routed every collection through `getCollectionTracks`,
+     * but the host asks `catalog.getAlbumTracks` for `type: 'album'` collections — without this
+     * member an album card opened to an empty grid. Omit and albums stay non-openable.
+     */
+    getAlbumTracks?(albumId: string, page: { limit: number; offset: number }):
+        Promise<{ items: FoliumProviderSong[]; hasMore: boolean; total?: number }>;
+}
+
+/**
+ * EXPERIMENTAL (`omni.providers`): recommendations for a mod provider.
+ *
+ * Declaring any member lights up the host's 电台 tab (it checks `capabilities.recommendations`),
+ * which renders one card for personal FM, one for the daily list and one per recommended
+ * collection. Members the mod leaves out simply yield empty cards.
+ *
+ * LOCAL CHANGE (bodian-source): the contract had no recommendations member at all, so a mod
+ * provider's 电台 tab could never leave its disabled state.
+ */
+export interface FoliumOmniProviderRecommendations {
+    /** Personal FM: fresh tracks for the FM queue. */
+    getPersonalFm?(): Promise<FoliumProviderSong[]>;
+    /** Daily recommendations. `refresh` asks for a new draw of the same list. */
+    getDailySongs?(refresh?: boolean): Promise<FoliumProviderSong[]>;
+    /** Recommended collections (playlists etc) shown alongside the two fixed cards. */
+    getRecommendedCollections?(limit: number): Promise<FoliumProviderCollection[]>;
+}
+
 /**
  * EXPERIMENTAL (`omni.providers`): an online music source. The host adapts it
  * to its provider contract; songs from it play, queue and show lyrics like any
@@ -1027,6 +1160,12 @@ export interface FoliumOmniProviderDef {
     getAudioUrl?(song: FoliumProviderSong, quality: FoliumAudioQuality): Promise<{ url: string; expiresAt?: number } | null>;
     /** LRC text (plus optional translation LRC); the host parses it. */
     getLyrics?(song: FoliumProviderSong): Promise<{ lrc: string; translationLrc?: string } | null>;
+    /** Account login. Omit to make the provider anonymous-only. */
+    auth?: FoliumOmniProviderAuth;
+    /** The user's library (playlists etc). Omit to leave the host's library tabs disabled. */
+    library?: FoliumOmniProviderLibrary;
+    /** Recommendations (personal FM / daily list / recommended collections). Omit to leave 电台 off. */
+    recommendations?: FoliumOmniProviderRecommendations;
 }
 
