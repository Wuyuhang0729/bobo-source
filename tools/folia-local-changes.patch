+
+const SearchCollectionCard: React.FC<SearchCollectionCardProps> = ({ collection, isDaylight, onOpen }) => {
+    const subtitle = [
+        collection.creator?.nickname,
+        collection.trackCount ? `${collection.trackCount} 首` : '',
+    ].filter(Boolean).join(' · ');
