+                    ? 'border-black/10 bg-black/[0.03] hover:bg-black/[0.07]'
+                    : 'border-white/10 bg-white/[0.04] hover:bg-white/[0.09]'
+            }`}
+        >
+            {collection.coverUrl ? (
+                <img
+                    src={collection.coverUrl}
+                    alt=""
+                    loading="lazy"
+                    className="h-12 w-12 shrink-0 rounded-xl object-cover"
+                />
+            ) : (
+                <span className={FALLBACK_COVER_CLASS}>
+                    <ListMusic size={18} />
+                </span>
+            )}
+            <span className="min-w-0 flex-1">
+                <span className="block truncate text-sm font-medium">{collection.name}</span>
+                <span className="block truncate text-xs opacity-60">{subtitle}</span>
+            </span>
+        </button>
+    );
+};
+
+export default SearchCollectionCard;
